# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from Apps & Credentials > your app > Webhooks (URL: <APP_URL>/api/webhooks/paypal)
PAYPAL_WEBHOOK_ID=
# Public client id for the browser SDK (same as PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Supabase (server-only secret key; row-level security blocks public keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google AI Studio key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

APP_URL=http://localhost:3000

# Email of the sandbox Personal account the demo's patient pays with
SANDBOX_BUYER_EMAIL=
